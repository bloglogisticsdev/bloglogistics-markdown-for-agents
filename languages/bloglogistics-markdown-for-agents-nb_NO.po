msgid "Use the submenu items to manage BlogLogistics plugin settings."
msgstr "Bruk undermenyelementene til å administrere innstillingene for BlogLogistics-utvidelser."

msgid "Markdown for Agents"
msgstr "Markdown for agenter"

msgid "This plugin provides a Markdown-friendly homepage for agents, tools, and other clients that prefer machine-readable content."
msgstr "Denne utvidelsen gir en Markdown-vennlig forside for agenter, verktøy og andre klienter som foretrekker maskinlesbart innhold."

msgid "Settings saved."
msgstr "Innstillingene ble lagret."

msgid "Recommended defaults restored."
msgstr "Anbefalte standarder ble gjenopprettet."

msgid "Enable Markdown homepage"
msgstr "Aktiver Markdown-forside"

msgid "Creates a Markdown version of the homepage at /index.md."
msgstr "Oppretter en Markdown-versjon av forsiden på /index.md."

msgid "Support Markdown requests for the homepage"
msgstr "Støtt Markdown-forespørsler for forsiden"

msgid "Returns Markdown when the homepage is requested by software that asks for text/markdown."
msgstr "Returnerer Markdown når forsiden bes om av programvare som ber om text/markdown."

msgid "Add discovery headers"
msgstr "Legg til oppdagelseshoder"

msgid "Adds headers that tell agents where to find the Markdown homepage, canonical homepage, and sitemap."
msgstr "Legger til hoder som forteller agenter hvor de finner Markdown-forsiden, kanonisk forside og nettstedskart."

msgid "Include homepage content"
msgstr "Inkluder forsideinnhold"

msgid "Adds the published homepage content to the Markdown output."
msgstr "Legger det publiserte forsideinnholdet til Markdown-utdataene."

msgid "Include important pages"
msgstr "Inkluder viktige sider"

msgid "Lists published pages in the Markdown output."
msgstr "Lister publiserte sider i Markdown-utdataene."

msgid "Maximum number of pages to list"
msgstr "Maksimalt antall sider som skal listes"

msgid "Default is 20. Allowed range is 1 to 100."
msgstr "Standard er 20. Tillatt område er 1 til 100."

msgid "Include machine-readable access links"
msgstr "Inkluder maskinlesbare tilgangslenker"

msgid "Adds links for the homepage, Markdown homepage, sitemap, and robots policy."
msgstr "Legger til lenker for forsiden, Markdown-forsiden, nettstedskartet og robots-policyen."

msgid "Include website-use preferences from robots.txt"
msgstr "Inkluder preferanser for nettstedsbruk fra robots.txt"

msgid "Shows the current Content-Signal preference from robots.txt when available. If the BlogLogistics robots.txt plugin manages that line, this plugin follows the value already published there instead of creating a separate setting."
msgstr "Viser gjeldende Content-Signal-preferanse fra robots.txt når den er tilgjengelig. Hvis BlogLogistics robots.txt-utvidelsen administrerer den linjen, følger denne utvidelsen verdien som allerede er publisert der, i stedet for å lage en egen innstilling."

msgid "Recommended defaults"
msgstr "Anbefalte standarder"

msgid "The recommended defaults keep all Markdown agent features turned on, list up to 20 pages, and follow the website-use preference already published in robots.txt."
msgstr "De anbefalte standardene holder alle Markdown-agentfunksjoner slått på, lister opptil 20 sider og følger preferansen for nettstedsbruk som allerede er publisert i robots.txt."

msgid "Save Settings"
msgstr "Lagre innstillinger"

msgid "Restore recommended defaults"
msgstr "Gjenopprett anbefalte standarder"

msgid "You do not have permission to access this page."
msgstr "Du har ikke tillatelse til å få tilgang til denne siden."

msgid "You do not have permission to save these settings."
msgstr "Du har ikke tillatelse til å lagre disse innstillingene."

msgid "You do not have permission to restore these settings."
msgstr "Du har ikke tillatelse til å gjenopprette disse innstillingene."

msgid "Homepage Content"
msgstr "Forsideinnhold"

msgid "Important Pages"
msgstr "Viktige sider"

msgid "Machine-readable Access"
msgstr "Maskinlesbar tilgang"

msgid "Homepage"
msgstr "Forside"

msgid "Markdown homepage"
msgstr "Markdown-forside"

msgid "Sitemap"
msgstr "Nettstedskart"

msgid "Robots policy"
msgstr "Robots-policy"
