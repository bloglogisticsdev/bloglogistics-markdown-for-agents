msgid "Use the submenu items to manage BlogLogistics plugin settings."
msgstr "Use los elementos del submenú para gestionar los ajustes de los plugins de BlogLogistics."

msgid "Markdown for Agents"
msgstr "Markdown para agentes"

msgid "This plugin provides a Markdown-friendly homepage for agents, tools, and other clients that prefer machine-readable content."
msgstr "Este plugin proporciona una página de inicio compatible con Markdown para agentes, herramientas y otros clientes que prefieren contenido legible por máquina."

msgid "Settings saved."
msgstr "Ajustes guardados."

msgid "Recommended defaults restored."
msgstr "Valores recomendados restaurados."

msgid "Enable Markdown homepage"
msgstr "Activar página de inicio en Markdown"

msgid "Creates a Markdown version of the homepage at /index.md."
msgstr "Crea una versión Markdown de la página de inicio en /index.md."

msgid "Support Markdown requests for the homepage"
msgstr "Admitir solicitudes Markdown para la página de inicio"

msgid "Returns Markdown when the homepage is requested by software that asks for text/markdown."
msgstr "Devuelve Markdown cuando la página de inicio es solicitada por software que pide text/markdown."

msgid "Add discovery headers"
msgstr "Añadir cabeceras de descubrimiento"

msgid "Adds headers that tell agents where to find the Markdown homepage, canonical homepage, and sitemap."
msgstr "Añade cabeceras que indican a los agentes dónde encontrar la página Markdown, la página canónica y el mapa del sitio."

msgid "Include homepage content"
msgstr "Incluir contenido de la página de inicio"

msgid "Adds the published homepage content to the Markdown output."
msgstr "Añade el contenido publicado de la página de inicio a la salida Markdown."

msgid "Include important pages"
msgstr "Incluir páginas importantes"

msgid "Lists published pages in the Markdown output."
msgstr "Lista las páginas publicadas en la salida Markdown."

msgid "Maximum number of pages to list"
msgstr "Número máximo de páginas a listar"

msgid "Default is 20. Allowed range is 1 to 100."
msgstr "El valor predeterminado es 20. El rango permitido es de 1 a 100."

msgid "Include machine-readable access links"
msgstr "Incluir enlaces de acceso legibles por máquina"

msgid "Adds links for the homepage, Markdown homepage, sitemap, and robots policy."
msgstr "Añade enlaces a la página de inicio, la página Markdown, el mapa del sitio y la política robots."

msgid "Include website-use preferences from robots.txt"
msgstr "Incluir preferencias de uso del sitio desde robots.txt"

msgid "Shows the current Content-Signal preference from robots.txt when available. If the BlogLogistics robots.txt plugin manages that line, this plugin follows the value already published there instead of creating a separate setting."
msgstr "Muestra la preferencia Content-Signal actual de robots.txt cuando está disponible. Si el plugin de robots.txt de BlogLogistics gestiona esa línea, este plugin sigue el valor ya publicado allí en lugar de crear un ajuste separado."

msgid "Recommended defaults"
msgstr "Valores recomendados"

msgid "The recommended defaults keep all Markdown agent features turned on, list up to 20 pages, and follow the website-use preference already published in robots.txt."
msgstr "Los valores recomendados mantienen activadas todas las funciones Markdown para agentes, listan hasta 20 páginas y siguen la preferencia de uso del sitio ya publicada en robots.txt."

msgid "Save Settings"
msgstr "Guardar ajustes"

msgid "Restore recommended defaults"
msgstr "Restaurar valores recomendados"

msgid "You do not have permission to access this page."
msgstr "No tiene permiso para acceder a esta página."

msgid "You do not have permission to save these settings."
msgstr "No tiene permiso para guardar estos ajustes."

msgid "You do not have permission to restore these settings."
msgstr "No tiene permiso para restaurar estos ajustes."

msgid "Homepage Content"
msgstr "Contenido de la página de inicio"

msgid "Important Pages"
msgstr "Páginas importantes"

msgid "Machine-readable Access"
msgstr "Acceso legible por máquina"

msgid "Homepage"
msgstr "Página de inicio"

msgid "Markdown homepage"
msgstr "Página de inicio Markdown"

msgid "Sitemap"
msgstr "Mapa del sitio"

msgid "Robots policy"
msgstr "Política robots"
